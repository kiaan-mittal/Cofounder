# Dissent — environment
# Copy to .env.local. Never commit real keys; .env.local is gitignored.

# ---------------------------------------------------------------------------
# Model access (required for live debate)
# ---------------------------------------------------------------------------
# One of these two is required. Without either, the Arena still runs — the
# worked example and WebMCP still work — but it cannot build a Company Brain
# from live sources or argue a new round.

OPENAI_API_KEY=
# AI_GATEWAY_API_KEY=

OPENAI_MODEL=gpt-4o
OPENAI_FALLBACK_MODEL=gpt-4.1
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# GitHub (optional)
# ---------------------------------------------------------------------------
# Raises the public API rate limit for *public* repo reads. Never used to
# sign anyone in. Sign-in is Composio or a GitHub OAuth app, per user.
GITHUB_TOKEN=

# Composio — Sign in with GitHub for *each* user (recommended).
# Create a key at https://platform.composio.dev → API keys.
# Then open /login and click Continue with GitHub. Composio's GitHub app
# asks that person to authorize. Their repos, not yours.
COMPOSIO_API_KEY=
# Optional. If you already created a GitHub Auth Config in the Composio
# dashboard, paste its id (ac_...). Otherwise the app creates one.
# COMPOSIO_GITHUB_AUTH_CONFIG_ID=
# Optional. Slack / Notion auth configs for export_decision.
# If unset, the app creates Composio-managed ones and caches the ids.
# COMPOSIO_SLACK_AUTH_CONFIG_ID=
# COMPOSIO_NOTION_AUTH_CONFIG_ID=

# Sign in with GitHub — fallback if you are not using Composio.
# One product OAuth app. Users only click Authorize.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Optional. Defaults to http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Firecrawl (optional — deeper Company Brain on JS-rendered sites)
# ---------------------------------------------------------------------------
# Without this key the Brain still crawls with the built-in reader.
# With it, it maps the public site and scrapes pricing, docs and the rest
# of the JavaScript-rendered pages a homepage fetch misses.
# FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=https://api.firecrawl.dev

# ---------------------------------------------------------------------------
# Supabase (workspace + onboarding field persistence)
# ---------------------------------------------------------------------------
# Create a project at https://supabase.com/dashboard then paste:
# Project Settings → API → Project URL and service_role key.
# Run supabase/migrations/20260830120000_workspaces.sql, then
# 20260831120000_github_token_sealed.sql, then
# 20260831160000_users_projects.sql, then
# 20260831190000_composio_user.sql, then
# 20260901120000_decision_shares.sql in the SQL editor.
# Local share links work without the last migration (JSON file).
# Production share/export needs it.
# Users own many projects. Each project is one repository + website.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Not used for writes; the API uses the service role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Cron (Company Brain refresh every 3 days)
# ---------------------------------------------------------------------------
# Vercel Cron and the GitHub Actions workflow both call GET /api/cron/brain
# with Authorization: Bearer $CRON_SECRET. Also set repository secrets
# APP_URL (https://your-domain) and CRON_SECRET for .github/workflows.
# Run supabase/migrations/20260831120000_github_token_sealed.sql so private
# repos can be re-read without a browser session.
CRON_SECRET=

# ---------------------------------------------------------------------------
# WebMCP origin trial (Chrome 149–156)
# ---------------------------------------------------------------------------
# Register https://decisionarena.vercel.app at
# https://developer.chrome.com/origintrials and paste the token. Without it,
# production Chrome only gets native document.modelContext if the visitor
# enabled chrome://flags/#enable-webmcp-testing. ChatGPT Sol/Terra does not
# need this token.
# WEBMCP_ORIGIN_TRIAL_TOKEN=
